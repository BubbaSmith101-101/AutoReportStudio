{
  "Serilog": {
    "MinimumLevel": "Debug",
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "c:\\Logs\\AutoReportStudio\\log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [{SourceContext}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "Ollama": {
    "BaseUrl": "http://localhost:11434",
    "Model": "qwen3-coder:30b"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=Bubba;Database=OfficeAttendance;Integrated Security=True;TrustServerCertificate=True;"
  },
  "AllowedHosts": "*"
}
