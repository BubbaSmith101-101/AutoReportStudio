@model HomeVm

<!-- Loading Spinner Overlay -->
<div id="loadingOverlay" class="loading-overlay" style="display: none;">
    <div class="spinner-container">
        <div class="spinner"></div>
        <p id="loadingMessage">Generating your report...</p>
        <p id="processingStatus" class="processing-status"></p>
    </div>
</div>

<h1>AI Database Report Generator</h1>
<p>SQL Server schema discovery + local Ollama + read-only report generation.</p>

@if (Model.Error != null)
{
    <div class="error">@Model.Error</div>
}

<div class="card">
    <h2>1. Connect</h2>
    <form asp-action="Discover" method="post" id="discoverForm">
        @Html.AntiForgeryToken()
        <fieldset id="discoverFieldset">
        <label>SQL Server connection string</label>
        <textarea asp-for="ConnectionString" rows="3"></textarea>
        <p class="hint">Use a SELECT-only SQL Server account.</p>
        <button class="btn btn-secondary" type="submit">Discover Tables</button>
        </fieldset>
    </form>
</div>

@if (Model.Schema != null)
{
    <form asp-action="Generate" method="post" id="generateForm">
        @Html.AntiForgeryToken()
        <fieldset id="generateFieldset">
        <div class="card">
            <h2>2. Select tables — @Model.Schema.DatabaseName</h2>
            <div class="table-select-actions">
                <button type="button" id="selectAllTablesBtn" class="btn btn-secondary btn-sm">Select All</button>
                <button type="button" id="clearAllTablesBtn" class="btn btn-secondary btn-sm">Clear All</button>
                <div class="pagination-controls">
                    <span class="page-info">Page @Model.CurrentPage of @Model.TotalPages (@Model.TotalItems tables)</span>
                    <label class="page-size-label">Show
                        <select id="pageSizeSelect" class="page-size-select">
                            @foreach (var size in new[] { 10, 20, 50, 100 })
                            {
                                <option value="@size" selected="@(Model.PageSize == size ? "selected" : null)">@size</option>
                            }
                            <option value="all" selected="@(Model.PageSize >= Model.TotalItems ? "selected" : null)">All</option>
                        </select>
                    </label>
                    <button type="button" id="firstPageBtn" class="btn btn-secondary btn-sm" @(Model.CurrentPage <= 1 ? "disabled" : "")>&laquo;</button>
                    <button type="button" id="prevPageBtn" class="btn btn-secondary btn-sm" @(Model.CurrentPage <= 1 ? "disabled" : "")>&lt;</button>
                    <button type="button" id="nextPageBtn" class="btn btn-secondary btn-sm" @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")>&gt;</button>
                    <button type="button" id="lastPageBtn" class="btn btn-secondary btn-sm" @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")>&raquo;</button>
                </div>
            </div>
            <div class="table-list" id="table-list-container">
                @for (int i = 0; i < Model.Schema.Tables.Count; i++)
                {
                    var t = Model.Schema.Tables[i];
                    var v = $"{t.Schema}.{t.Name}";
                    <label class="choice" data-table-index="@i">
                        <input type="checkbox" name="SelectedTables" value="@v" />
                        <b>@v</b>
                        <small>@t.Columns.Count columns · @t.ForeignKeys.Count relationships</small>
                    </label>
                }
            </div>
        </div>

        <div class="card" id="modelsCard">
            <h2>3. Select Language Model</h2>
            <fieldset id="modelsFieldset">
            <label>Available AI Models</label>
            <select id="modelSelect">
                <option value="">Loading models...</option>
            </select>
            <p class="hint" id="modelHint">Connecting to Ollama to fetch available models.</p>
            </fieldset>
        </div>

        <div class="card">
            <h2>4. Describe the report</h2>
            <textarea asp-for="Request" rows="5"></textarea>
            <button id="generateButton" type="submit" class="btn btn-primary" disabled>
                <span id="generateSpinner" class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                <span id="generateButtonText">Generate Report</span>
            </button>
            <p class="hint" id="validationMessage" style="display:none; color: #d32f2f; margin-top: 10px;"></p>
        </div>
        </fieldset>
    </form>
}

<script>
    function formatBytes(bytes) {
        if (!bytes || bytes <= 0) return null;
        const gb = bytes / (1024 * 1024 * 1024);
        if (gb >= 1) return gb.toFixed(1) + ' GB';
        const mb = bytes / (1024 * 1024);
        return mb.toFixed(0) + ' MB';
    }

    function formatModelLabel(model) {
        const name = model && model.name ? model.name : model;
        const sizeLabel = (model && model.parameterSize)
            ? model.parameterSize
            : formatBytes(model ? model.sizeBytes : 0);
        return sizeLabel ? `${name} (${sizeLabel})` : name;
    }

    function parseParameterSize(parameterSize) {
        if (!parameterSize) return 0;
        const match = /^([\d.]+)\s*([kmbtKMBT])?/.exec(parameterSize.trim());
        if (!match) return 0;
        const value = parseFloat(match[1]);
        if (isNaN(value)) return 0;
        const unit = (match[2] || '').toUpperCase();
        const multipliers = { K: 1e3, M: 1e6, B: 1e9, T: 1e12 };
        return value * (multipliers[unit] || 1);
    }

    function getModelSortValue(model) {
        if (!model) return 0;
        const paramValue = parseParameterSize(model.parameterSize);
        return paramValue > 0 ? paramValue : (model.sizeBytes || 0);
    }

    async function loadModels() {
        console.log('Attempting to load models from /Report/GetModels');
        try {
            const response = await fetch('/Report/GetModels', { 
                method: 'GET',
                headers: {
                    'Accept': 'application/json'
                }
            });

            console.log('GetModels response status:', response.status);

            if (!response.ok) {
                throw new Error(`HTTP error! status: ${response.status}`);
            }

            const models = await response.json();
            console.log('Received models:', models);

            const select = document.getElementById('modelSelect');
            const hint = document.getElementById('modelHint');

            // Add null checks to prevent error when elements don't exist
            if (!select) {
                console.error('modelSelect element not found');
                return;
            }

            if (models && Array.isArray(models) && models.length > 0) {
                models.sort((a, b) => getModelSortValue(b) - getModelSortValue(a));
                select.innerHTML = '<option value="">-- Select a model --</option>';
                models.forEach(model => {
                    const option = document.createElement('option');
                    option.value = model.name;
                    option.textContent = formatModelLabel(model);
                    select.appendChild(option);
                });
                if (hint) hint.textContent = 'Select an AI model to use for report generation.';
            } else {
                select.innerHTML = '<option value="">No models available</option>';
                if (hint) hint.textContent = 'No AI models found. Please ensure Ollama is running and models are installed.';
            }
            validateForm();
        } catch (error) {
            console.error('Error loading models:', error);
            const hint = document.getElementById('modelHint');
            if (hint) hint.textContent = `Failed to load models: ${error.message}`;
            const select = document.getElementById('modelSelect');
            if (select) select.innerHTML = '<option value="">Failed to load models</option>';
        }
    }

    // Call loadModels after DOM is fully loaded
    document.addEventListener('DOMContentLoaded', loadModels);

    // Disable Discover form's fieldset while it submits
    const discoverForm = document.getElementById('discoverForm');
    if (discoverForm) {
        discoverForm.addEventListener('submit', function() {
            // Defer disabling until after the browser has captured form data,
            // otherwise disabled fields are excluded from the submission.
            setTimeout(() => {
                const discoverFieldset = document.getElementById('discoverFieldset');
                if (discoverFieldset) discoverFieldset.disabled = true;
            }, 0);
        });
    }

    // Add event listeners for form validation triggers
    const modelSelect = document.getElementById('modelSelect');
    const requestTextarea = document.querySelector('[name="Request"]');
    const checkboxes = document.querySelectorAll('[name="SelectedTables"]');

    if (modelSelect) {
        modelSelect.addEventListener('change', validateForm);
    }

    if (requestTextarea) {
        requestTextarea.addEventListener('input', validateForm);
    }

    checkboxes.forEach(checkbox => {
        checkbox.addEventListener('change', validateForm);
    });

    const selectAllTablesBtn = document.getElementById('selectAllTablesBtn');
    const clearAllTablesBtn = document.getElementById('clearAllTablesBtn');

    if (selectAllTablesBtn) {
        selectAllTablesBtn.addEventListener('click', function () {
            checkboxes.forEach(checkbox => { checkbox.checked = true; });
            validateForm();
        });
    }

    if (clearAllTablesBtn) {
        clearAllTablesBtn.addEventListener('click', function () {
            checkboxes.forEach(checkbox => { checkbox.checked = false; });
            validateForm();
        });
    }

    function validateForm() {
        const modelSelect = document.getElementById('modelSelect');
        const requestTextarea = document.querySelector('[name="Request"]');
        const tableCheckboxes = document.querySelectorAll('[name="SelectedTables"]:checked');
        const generateButton = document.getElementById('generateButton');
        const validationMessage = document.getElementById('validationMessage');

        console.log('validateForm called:', {
            modelSelect: modelSelect ? modelSelect.value : 'not found',
            requestValue: requestTextarea ? requestTextarea.value : 'not found',
            checkboxesChecked: tableCheckboxes.length
        });

        if (!modelSelect || !requestTextarea || !generateButton) {
            console.log('validateForm: missing required elements');
            return;
        }

        const modelSelected = modelSelect.value !== '';
        const requestFilled = requestTextarea.value.trim() !== '';
        const tablesSelected = tableCheckboxes && tableCheckboxes.length > 0;
        const isFormValid = modelSelected && requestFilled && tablesSelected;

        console.log('Validation results:', { modelSelected, requestFilled, tablesSelected, isFormValid });

        generateButton.disabled = !isFormValid;

        if (!isFormValid && tablesSelected) {
            const missingFields = [];
            if (!modelSelected) missingFields.push('AI Model');
            if (!requestFilled) missingFields.push('Report Description');

            if (missingFields.length > 0) {
                validationMessage.textContent = 'Please fill in: ' + missingFields.join(', ');
                validationMessage.style.display = 'block';
            } else {
                validationMessage.style.display = 'none';
            }
        } else if (!tablesSelected) {
            validationMessage.textContent = 'Please select at least one table';
            validationMessage.style.display = 'block';
        } else {
            validationMessage.style.display = 'none';
        }
    }

    // Add submit handler to show loading overlay
    const generateForm = document.getElementById('generateForm');
    if (generateForm) {
        generateForm.addEventListener('submit', function(e) {
            const modelSelect = document.getElementById('modelSelect');
            if (modelSelect && modelSelect.value) {
                // Add model and connection string as hidden inputs before submit
                const modelInput = document.createElement('input');
                modelInput.type = 'hidden';
                modelInput.name = 'SelectedModel';
                modelInput.value = modelSelect.value;
                generateForm.appendChild(modelInput);

                const connInput = document.createElement('input');
                connInput.type = 'hidden';
                connInput.name = 'ConnectionString';
                connInput.value = document.querySelector('[name="ConnectionString"]').value;
                generateForm.appendChild(connInput);

                showLoadingSpinner();

                // Defer disabling inputs until after the browser has captured
                // the form data, otherwise disabled fields (checkboxes, select,
                // textarea) are excluded from the submission.
                setTimeout(disableFormInputs, 0);
            }
        });
    }

    function disableFormInputs() {
        // Disable all fieldsets across the page so nothing can be changed while processing
        const fieldsets = document.querySelectorAll('fieldset');
        fieldsets.forEach(fs => fs.disabled = true);

        // Update the Generate button to show a spinner and disable it explicitly
        const generateButton = document.getElementById('generateButton');
        const generateSpinner = document.getElementById('generateSpinner');
        const generateButtonText = document.getElementById('generateButtonText');
        if (generateButton) {
            generateButton.disabled = true;
        }
        if (generateSpinner) {
            generateSpinner.classList.remove('d-none');
        }
        if (generateButtonText) {
            generateButtonText.textContent = 'Generating...';
        }
    }

    function showLoadingSpinner() {
        const overlay = document.getElementById('loadingOverlay');
        const processingStatus = document.getElementById('processingStatus');
        if (overlay) {
            overlay.style.display = 'block';
        }
        if (processingStatus) {
            processingStatus.textContent = 'Connecting...';
        }
    }

    // Pagination functionality
    (function () {
        const firstBtn = document.getElementById('firstPageBtn');
        const prevBtn = document.getElementById('prevPageBtn');
        const nextBtn = document.getElementById('nextPageBtn');
        const lastBtn = document.getElementById('lastPageBtn');
        const pageSizeSelect = document.getElementById('pageSizeSelect');
        const tableListContainer = document.getElementById('table-list-container');
        const tableCount = @Model.Schema?.Tables.Count ?? 0;
        let pageSize = @Model.PageSize;
        let totalPages = @Model.TotalPages;
        let currentPage = @Model.CurrentPage;

        function getPageSize() {
            if (!pageSizeSelect) return pageSize;
            return pageSizeSelect.value === 'all' ? tableCount || 1 : parseInt(pageSizeSelect.value);
        }

        function showPage(page) {
            pageSize = getPageSize();
            totalPages = Math.max(1, Math.ceil(tableCount / pageSize));
            if (page < 1) page = 1;
            if (page > totalPages) page = totalPages;

            const startIndex = (page - 1) * pageSize;
            const endIndex = Math.min(startIndex + pageSize, tableCount);

            // Hide all table items first
            const allLabels = tableListContainer.querySelectorAll('.choice');
            allLabels.forEach(label => {
                label.style.display = 'none';
            });

            // Show only items for current page
            for (let i = startIndex; i < endIndex; i++) {
                const label = tableListContainer.querySelector(`.choice[data-table-index="${i}"]`);
                if (label) {
                    label.style.display = '';
                }
            }

            // Update active page
            currentPage = page;

            // Update button states
            if (firstBtn) {
                firstBtn.disabled = currentPage <= 1;
            }
            if (prevBtn) {
                prevBtn.disabled = currentPage <= 1;
            }
            if (nextBtn) {
                nextBtn.disabled = currentPage >= totalPages;
            }
            if (lastBtn) {
                lastBtn.disabled = currentPage >= totalPages;
            }

            // Update page info
            const pageInfo = document.querySelector('.page-info');
            if (pageInfo) {
                pageInfo.textContent = `Page ${currentPage} of ${totalPages} (${tableCount} tables)`;
            }
        }

        if (firstBtn) {
            firstBtn.addEventListener('click', () => showPage(1));
        }
        if (prevBtn) {
            prevBtn.addEventListener('click', () => showPage(currentPage - 1));
        }
        if (nextBtn) {
            nextBtn.addEventListener('click', () => showPage(currentPage + 1));
        }
        if (lastBtn) {
            lastBtn.addEventListener('click', () => showPage(totalPages));
        }
        if (pageSizeSelect) {
            pageSizeSelect.addEventListener('change', () => showPage(1));
        }

        // Initialize - hide items not on current page
        showPage(currentPage);
    })();
</script>
