@model ReportResult
@using System.Text.Json
@functions {
    static string FormatCell(string? value)
    {
        if (string.IsNullOrEmpty(value)) return value ?? "";
        if (DateTime.TryParse(value, out var dt) && value.Contains(':'))
        {
            return dt.TimeOfDay == TimeSpan.Zero ? dt.ToString("d") : dt.ToString("g");
        }
        return value;
    }
}
<div class="head" id="report-top"><div><a asp-action="Index">← New report</a><h1>@Model.Title</h1></div><form asp-action="Export" method="post"><button>Export Excel</button></form></div>

<!-- Report Metrics -->
<div class="card metrics-card">
    <h3>Report Generation Metrics</h3>
    <div class="metrics-grid">
        <div class="metric">
            <span class="metric-label">Processing Time</span>
            <span class="metric-value">@((Model.ProcessingTimeMs / 1000.0).ToString("F2"))s</span>
        </div>
        <div class="metric">
            <span class="metric-label">Tokens Generated</span>
            <span class="metric-value">@Model.TokensGenerated.ToString("N0")</span>
        </div>
        <div class="metric">
            <span class="metric-label">Tokens / Second</span>
            <span class="metric-value">@((Model.ProcessingTimeMs > 0 ? Model.TokensGenerated / (Model.ProcessingTimeMs / 1000.0) : 0).ToString("F2"))</span>
        </div>
        <div class="metric">
            <span class="metric-label">Time to First Token</span>
            <span class="metric-value">@((Model.TimeToFirstTokenMs / 1000.0).ToString("F2"))s</span>
        </div>
        <div class="metric">
            <span class="metric-label">Generated</span>
            <span class="metric-value">@Model.GeneratedUtc.ToLocalTime().ToString("g")</span>
        </div>
        <div class="metric">
            <span class="metric-label">Model Used</span>
            <span class="metric-value">@(string.IsNullOrEmpty(Model.ModelUsed) ? "Default" : Model.ModelUsed)</span>
        </div>
        <div class="metric metric-wide">
            <span class="metric-label">Instructions</span>
            <span class="metric-value">@Model.UserRequest</span>
        </div>
    </div>
</div>

<div class="card"><h2>Executive Summary</h2><p>@Model.Summary</p></div>
@{ int chartIndex = 0; }
@foreach (var s in Model.Sections)
{
    <details class="card section-card" open>
        <summary class="section-summary"><h2>@s.Heading</h2></summary>
        <p>@s.Purpose</p>
        @if (string.Equals(s.Type, "chart", StringComparison.OrdinalIgnoreCase) && !string.IsNullOrEmpty(s.XAxis) && !string.IsNullOrEmpty(s.YAxis) && s.Columns.Count > 0)
        {
            var canvasId = $"chart_{chartIndex}";
            var xIdx = s.Columns.FindIndex(c => string.Equals(c, s.XAxis, StringComparison.OrdinalIgnoreCase));
            var yIdx = s.Columns.FindIndex(c => string.Equals(c, s.YAxis, StringComparison.OrdinalIgnoreCase));
            // If there is exactly one additional column beyond X and Y, treat it as a series/grouping column
            var seriesIdx = -1;
            var otherIdxs = Enumerable.Range(0, s.Columns.Count).Where(i => i != xIdx && i != yIdx).ToList();
            if (otherIdxs.Count == 1) { seriesIdx = otherIdxs[0]; }
            if (xIdx >= 0 && yIdx >= 0 && s.Rows.Count > 0)
            {
                var palette = new[] { "#4e79a7","#f28e2b","#e15759","#76b7b2","#59a14f","#edc948","#b07aa1","#ff9da7","#9c755f","#bab0ac" };
                var chartType = (s.ChartType ?? "bar").ToLowerInvariant();
                var jsChartType = chartType switch
                {
                    "column" => "bar",
                    "area" => "line",
                    "doughnut" => "doughnut",
                    "pie" => "pie",
                    "scatter" => "scatter",
                    "line" => "line",
                    _ => "bar"
                };
                var fill = chartType == "area";

                List<string> labels;
                List<object> datasets;
                if (seriesIdx >= 0)
                {
                    // Multi-series: group rows by the series column, one dataset per distinct value
                    labels = s.Rows.Select(r => r.Count > xIdx ? FormatCell(r[xIdx]) : "").Distinct().ToList();
                    var seriesGroups = s.Rows
                        .GroupBy(r => r.Count > seriesIdx ? (r[seriesIdx] ?? "") : "")
                        .OrderBy(g => g.Key)
                        .ToList();
                    datasets = new List<object>();
                    for (int si = 0; si < seriesGroups.Count; si++)
                    {
                        var g = seriesGroups[si];
                        var valueByLabel = g.ToDictionary(
                            r => r.Count > xIdx ? FormatCell(r[xIdx]) : "",
                            r => r.Count > yIdx ? (double.TryParse(r[yIdx], out var d) ? d : 0) : 0);
                        var seriesValues = labels.Select(l => valueByLabel.TryGetValue(l, out var v) ? v : 0).ToList();
                        var color = palette[si % palette.Length];
                        datasets.Add(new { label = g.Key, data = seriesValues, fill, backgroundColor = color, borderColor = color, tension = 0.3 });
                    }
                }
                else
                {
                    labels = s.Rows.Select(r => r.Count > xIdx ? FormatCell(r[xIdx]) : "").ToList();
                    var values = s.Rows.Select(r => r.Count > yIdx ? (double.TryParse(r[yIdx], out var d) ? d : 0) : 0).ToList();
                    datasets = new List<object> { new { label = s.YAxisTitle ?? s.YAxis, data = values, fill, backgroundColor = palette, borderColor = palette[0], tension = 0.3 } };
                }
                <div class="chart-container" style="position:relative; max-width:800px; margin-bottom:1rem;">
                    <canvas id="@canvasId"></canvas>
                </div>
                <script>
                    (function () {
                        var ctx = document.getElementById('@canvasId').getContext('2d');
                        new Chart(ctx, {
                            type: '@jsChartType',
                            data: {
                                labels: @Html.Raw(JsonSerializer.Serialize(labels)),
                                datasets: @Html.Raw(JsonSerializer.Serialize(datasets))
                            },
                            options: {
                                responsive: true,
                                plugins: {
                                    legend: { display: true }
                                },
                                scales: ('@jsChartType' === 'pie' || '@jsChartType' === 'doughnut') ? {} : {
                                    x: { title: { display: true, text: '@Html.Raw(s.XAxisTitle ?? s.XAxis)' } },
                                    y: { title: { display: true, text: '@Html.Raw(s.YAxisTitle ?? s.YAxis)' } }
                                }
                            }
                        });
                    })();
                </script>
                chartIndex++;
            }
            else
            {
                <p class="no-data">No data available to plot this chart.</p>
            }
        }
        else if (s.Columns.Count > 0)
        {
            <div class="scroll"><table><thead><tr>@foreach(var c in s.Columns){
                <th>@c</th>
        }
        </tr></thead><tbody>@foreach(var row in s.Rows){
        <tr>@foreach(var x in row){
            <td>@FormatCell(x)</td>
        }
    </tr>
}
</tbody></table></div>
        }
<details><summary>Generated SQL</summary><pre>@s.Sql</pre></details>
</details>
}

<a href="#report-top" id="backToTop" class="back-to-top" title="Back to top" aria-label="Back to top">↑</a>
<script>
    (function () {
        var btn = document.getElementById('backToTop');
        window.addEventListener('scroll', function () {
            btn.classList.toggle('visible', window.scrollY > 400);
        });
    })();
</script>